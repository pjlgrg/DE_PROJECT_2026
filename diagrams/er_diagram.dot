digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.65", ranksep="1.2", splines=polyline, dpi=130, fontname="Helvetica", fontsize=20, labelloc=t, label="Blinkit database | T0133 | 10 tables"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.8, labeldistance=1.8];
categories [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_perishable</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR></TABLE>>];
cities [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>cities</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">city_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">city_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(80)</FONT></TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">email ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">city_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR></TABLE>>];
dark_stores [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>dark_stores</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">store_code</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">city_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">opened_on</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">max_daily_orders</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR></TABLE>>];
inventory_movements [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>inventory_movements</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">movement_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">movement_type</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">moved_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>order_items</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity_ordered</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity_delivered</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">substitute_product_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">rider_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">placed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">packed_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">picked_up_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">delivered_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">promised_minutes</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">subtotal</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">delivery_fee</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">handling_fee</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">small_cart_fee</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>products</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">brand</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">pack_size</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">mrp</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">shelf_life_days ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR></TABLE>>];
riders [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>riders</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">rider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">joined_on</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR></TABLE>>];
store_inventory [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>store_inventory</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity_on_hand</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reorder_level</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">selling_price</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR></TABLE>>];
cities -> dark_stores [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="has stores"];
cities -> customers [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="has customers"];
categories -> products [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="groups"];
dark_stores -> store_inventory [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="stocks"];
products -> store_inventory [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="stocked at"];
dark_stores -> riders [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="has riders"];
dark_stores -> orders [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="serves"];
customers -> orders [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="places"];
riders -> orders [dir=both, arrowtail=odottee, arrowhead=ocrow, taillabel="0..1", headlabel="0..N", label="assigned to", style=dashed];
orders -> order_items [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="contains"];
products -> order_items [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="ordered product"];
products -> order_items [dir=both, arrowtail=odottee, arrowhead=ocrow, taillabel="0..1", headlabel="0..N", label="substitute", style=dashed];
store_inventory -> inventory_movements [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="has movements"];
legend [label="PK = primary key    FK = foreign key    UK = unique key
A composite key uses the listed columns together.    ? = nullable", shape=box, color="#94a3b8", fontsize=11];
}
